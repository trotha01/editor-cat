# Copy to .env for local development. Everything here is optional.

# Fakes every provider call locally, so no API keys and no network are needed.
# VITE_MOCK_PROVIDERS=1

# Google OAuth client ID (type: Web application). Used for two things: signing
# in, and saving media to your own Google Drive. Leave unset to build without
# either. Not a secret — it ships in the bundle, and origin allowlisting is what
# protects it. See the README for the setup steps.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Supabase project, where timelines are saved. Set both to enable cloud
# projects; leave both unset to run purely against this browser's storage.
# The anon key is public by design — row-level security is what protects data.
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
