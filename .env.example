# Copy to .env for local development. Everything here is optional.

# Fakes every provider call locally, so no API keys and no network are needed.
# VITE_MOCK_PROVIDERS=1

# Google OAuth client ID (type: Web application) for saving media to your own
# Google Drive. Leave unset to build without the Drive integration.
# Not a secret: it ships in the bundle, and origin allowlisting is what
# protects it. See the README for the setup steps.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
